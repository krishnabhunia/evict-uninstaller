<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Evict.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisHidden" UseHidden="True" />
    <conv:InverseBoolConverter x:Key="InvBool" />
    <conv:TruthyConverter x:Key="ToBool" />
    <conv:EqualsConverter x:Key="EqualsToBool" />
    <conv:EqualsConverter x:Key="EqualsToVis" ToVisibility="True" />
    <conv:EqualsConverter x:Key="NotEqualsToVis" ToVisibility="True" Invert="True" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:DateConverter x:Key="Date" />
    <conv:DateConverter x:Key="DateTime" Format="dd MMM yyyy HH:mm" />
    <conv:MaximizedMarginConverter x:Key="MaxMargin" />
    <conv:BoolToBrushConverter x:Key="BoolToBrush" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:CountLabelConverter x:Key="CountLabel" />

</ResourceDictionary>
