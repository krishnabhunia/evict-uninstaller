    <SolidColorBrush x:Key="Brush.Success" Color="#5BD1A6" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#1F3E35" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F0BC65" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#423523" />
    <SolidColorBrush x:Key="Brush.Info.Subtle" Color="#213A56" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#26354B" />
