<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: coral/navy UI with RD1 functional resource keys retained. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#111C2D" />
    <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="#1C283C" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#0C1728" />
    <!-- The navigation rail stays dark in both themes. -->
    <SolidColorBrush x:Key="Brush.Sidebar.BrandText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Border" Color="#27374B" />

    <SolidColorBrush x:Key="Brush.Card.Background" Color="#1C283C" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#344259" />
    <SolidColorBrush x:Key="Brush.Card.Hover" Color="#243349" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#22272F" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDF2F9" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A3B2C7" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#8292A9" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#0C1018" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#5C6573" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF916C" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FFAD8B" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#E67B59" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#403127" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#795241" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFAD8B" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F0544A" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#F4736A" />
