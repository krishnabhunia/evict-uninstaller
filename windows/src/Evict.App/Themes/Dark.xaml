    <SolidColorBrush x:Key="Brush.Code.Background" Color="#12151B" />

    <SolidColorBrush x:Key="Brush.Nav.SelectedText" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Nav.GroupHeading" Color="#91A6C2" />

    <SolidColorBrush x:Key="Brush.Sidebar.Status" Color="#76DDB8" />

    <SolidColorBrush x:Key="Brush.Hero.Background" Color="#243E50" />

    <SolidColorBrush x:Key="Brush.Hero.Subtitle" Color="#C1D1DC" />

    <SolidColorBrush x:Key="Brush.SelectionBar.Background" Color="#263F59" />

    <SolidColorBrush x:Key="Brush.SelectionBar.Text" Color="#FFFFFF" />

</ResourceDictionary>
