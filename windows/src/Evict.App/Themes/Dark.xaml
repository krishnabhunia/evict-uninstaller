    <SolidColorBrush x:Key="Brush.Row.Alt" Color="#182437" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#344259" />
    <SolidColorBrush x:Key="Brush.Header.Background" Color="#26354B" />

    <SolidColorBrush x:Key="Brush.Nav.Selected" Color="#273E5A" />
    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#1D3048" />
    <SolidColorBrush x:Key="Brush.Nav.Text" Color="#B7C5DA" />
    <SolidColorBrush x:Key="Brush.Nav.Icon" Color="#91A6C2" />

    <SolidColorBrush x:Key="Brush.Tray.Background" Color="#ECEEF1" />
