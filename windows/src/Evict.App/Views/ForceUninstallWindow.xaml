<Window x:Class="Evict.App.Views.ForceUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        xmlns:views="clr-namespace:Evict.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ForceUninstallViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="Force Uninstall" Width="900" Height="640" MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/Assets/app.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Force Uninstall" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"
                       Text="For programs whose uninstaller is broken, missing or refuses to run. Evict finds every file, folder, shortcut, registry key, service and scheduled task that belongs to the program and lets you remove them." />
        </StackPanel>

        <!-- ═══ Target ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Target}">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton IsChecked="{Binding UseProgram}" Content="Pick from installed programs" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" IsEnabled="{Binding UseProgram}" Margin="24,8,0,16" MaxWidth="600" HorizontalAlignment="Left" MinWidth="420">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DisplayVersion, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <RadioButton IsChecked="{Binding UseProgram, Converter={StaticResource InvBool}}" Content="Point at the program's folder or main .exe" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <Grid Margin="24,8,0,0" IsEnabled="{Binding UseProgram, Converter={StaticResource InvBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Tag="C:\Program Files\SomeProgram  or  …\program.exe" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Folder…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="File…" Command="{Binding BrowseFileCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="24,8,0,0" IsEnabled="{Binding UseProgram, Converter={StaticResource InvBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Program name (optional, improves matching):" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Base}" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260" Tag="e.g. Foo Media Player" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />
                    <CheckBox IsChecked="{Binding KillProcesses}" Content="Close the program's running processes before removing files" />
                    <CheckBox IsChecked="{Binding SendToRecycleBin}" Content="Send files to the Recycle Bin instead of deleting permanently" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Scanning ═══ -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Scanning}">
            <TextBlock Style="{StaticResource Text.Section}" HorizontalAlignment="Center">
                <Run Text="Scanning for everything that belongs to " /><Run Text="{Binding TargetName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,12" />
            <ProgressBar Value="{Binding Progress}" Maximum="100" Width="420" />
        </StackPanel>

        <!-- ═══ Review ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding RunningProcesses.Count, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="The program is still running – these processes will be closed:" />
                    <ItemsControl ItemsSource="{Binding RunningProcesses}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Margin="0,0,0,8" Visibility="{Binding Warnings.Count, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <views:LeftoverReviewView Grid.Row="2" DataContext="{Binding Review}" />
        </Grid>

        <!-- ═══ Cleaning ═══ -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Cleaning}">
            <TextBlock Text="Removing…" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            <ProgressBar Value="{Binding Progress}" Maximum="100" Width="420" />
        </StackPanel>

        <!-- ═══ Done ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,18">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.Success.Subtle}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource Brush.Success}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Done" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}">
                        <Run Text="{Binding Removed, Mode=OneWay}" /><Run Text=" item(s) removed ·" />
                        <Run Text="{Binding Failed, Mode=OneWay}" /><Run Text=" failed ·" />
                        <Run Text="{Binding BytesReclaimedText, Mode=OneWay}" /><Run Text=" reclaimed" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding Errors.Count, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,2" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Footer ═══ -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Text="{Binding Review.SelectedSummary}" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Target}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" MinWidth="140">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Scan" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="100" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Scanning}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Back" Command="{Binding BackCommand}" MinWidth="100" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Danger}" Command="{Binding RemoveCommand}" MinWidth="180" IsEnabled="{Binding Review.SelectedCount, Converter={StaticResource ToBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Force remove selected" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource Button.Primary}" Content="Close" Command="{Binding CloseCommand}" MinWidth="120" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
