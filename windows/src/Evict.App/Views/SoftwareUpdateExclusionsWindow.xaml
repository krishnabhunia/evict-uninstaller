<Window x:Class="Evict.App.Views.SoftwareUpdateExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Title="Excluded software"
        Width="760" Height="520" MinWidth="600" MinHeight="400"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding ExclusionsLabel}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Excluded packages stay hidden across restarts. Restore them to include them in the next check; available updates return immediately."
                       Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <DataGrid x:Name="ExcludedList" Grid.Row="1" ItemsSource="{Binding Exclusions}"
                  Style="{StaticResource DataGrid.Flat}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="220" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource Brush.Warning}" />
        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="RestoreSelectedButton" Content="Restore selected" Style="{StaticResource Button.Primary}"
                    Click="RestoreSelected" IsEnabled="False" Margin="0,0,8,4" />
            <Button Content="Restore all" Style="{StaticResource Button.Secondary}" Click="RestoreAll" Margin="0,0,8,4"
                    IsEnabled="{Binding Exclusions.Count, Converter={StaticResource ToBool}}" />
            <Button Content="Close" Style="{StaticResource Button.Secondary}" Click="CloseWindow" IsCancel="True" Margin="0,0,0,4" />
        </WrapPanel>
    </Grid>
</Window>
