<Window x:Class="Evict.App.Views.UninstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        xmlns:views="clr-namespace:Evict.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UninstallWizardViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding Title}" Width="900" Height="640" MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/Assets/app.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ═══ Step 1: Confirm ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Confirm}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <ListBox Style="{StaticResource ListBox.Flat}" ItemsSource="{Binding Jobs}" IsHitTestVisible="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UninstallJobViewModel}">
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <CheckBox IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding IsElevated}" Content="Create a System Restore point first" ToolTip="{Binding RestorePointHint}" />
                    <TextBlock Text="{Binding RestorePointHint}" Style="{StaticResource Text.Caption}" Margin="26,2,0,8" />
                    <CheckBox IsChecked="{Binding QuietMode}" Content="Silent uninstall where the installer supports it (MSI, Inno Setup, NSIS…)" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding ScanLeftovers}" Content="Powerful Scan: search for leftover files, folders and registry entries afterwards" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding AutoClean}" IsEnabled="{Binding ScanLeftovers}" Content="Remove leftovers automatically (skip the review step; only 'Review' items are kept)" Margin="26,0,0,8" />
                    <CheckBox IsChecked="{Binding SendToRecycleBin}" Content="Send leftover files to the Recycle Bin instead of deleting permanently" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Step 2: Running ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Running}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
                <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding ProgressIndeterminate}" />
                <TextBlock Text="{Binding RestorePointMessage}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="{Binding RestorePointMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                <ListBox Style="{StaticResource ListBox.Flat}" ItemsSource="{Binding Jobs}" IsHitTestVisible="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UninstallJobViewModel}">
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusGlyph}" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsFail}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsOk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Expander Grid.Row="2" Header="Activity log" Margin="0,10,0,0" IsExpanded="False" Foreground="{DynamicResource Brush.Text.Secondary}">
                <TextBox Style="{StaticResource TextBox.Log}" Height="120" Margin="0,6,0,0" Text="{Binding LogText, Mode=OneWay}" />
            </Expander>
        </Grid>

        <!-- ═══ Step 3: Review leftovers ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                        <Run Text="Powerful Scan found " /><Run Text="{Binding Review.TotalCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" leftover item(s)." />
                        <Run Text="Items marked 'Review' are name-based guesses and are unchecked by default – tick them only if you are sure." Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <views:LeftoverReviewView Grid.Row="1" DataContext="{Binding Review}" />
        </Grid>

        <!-- ═══ Step 4: Cleaning ═══ -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Cleaning}">
            <TextBlock Text="Removing leftovers…" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            <ProgressBar Value="{Binding Progress}" Maximum="100" Width="420" />
        </StackPanel>

        <!-- ═══ Step 5: Done ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,18">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.Success.Subtle}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource Brush.Success}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Finished" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}">
                        <Run Text="{Binding ProgramsUninstalled, Mode=OneWay}" /><Run Text=" program(s) uninstalled ·" />
                        <Run Text="{Binding LeftoversRemoved, Mode=OneWay}" /><Run Text=" leftover item(s) removed ·" />
                        <Run Text="{Binding BytesReclaimedText, Mode=OneWay}" /><Run Text=" reclaimed" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding RegistrySummary, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding RegistrySummary}" />
                </Border>
                <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding RebootRecommended, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="A restart is recommended to finish removing files that were in use." />
                </Border>
                <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding ProgramsWithWarnings, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}">
                        <Run Text="{Binding ProgramsWithWarnings, Mode=OneWay}" /><Run Text=" program(s) reported a problem – check the list and log below. The program list will refresh when you close this window." />
                    </TextBlock>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Jobs}" Margin="10,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UninstallJobViewModel}">
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusGlyph}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFail}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Errors}" Margin="14,4,14,10" Visibility="{Binding Errors.Count, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="Activity log" Margin="14,0,14,10" IsExpanded="False" Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBox Style="{StaticResource TextBox.Log}" Height="140" Margin="0,6,0,0" Text="{Binding LogText, Mode=OneWay}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Footer buttons ═══ -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Text="{Binding Review.SelectedSummary}"
                       Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Confirm -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Confirm}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                    <Button Style="{StaticResource Button.Danger}" Command="{Binding StartCommand}" MinWidth="160">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Uninstall" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Running -->
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel remaining" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" MinWidth="140"
                        Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Running}" />
                <!-- Review -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Skip cleanup" Command="{Binding SkipCleanupCommand}" MinWidth="120" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Danger}" Command="{Binding RemoveSelectedLeftoversCommand}" MinWidth="180">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Delete selected leftovers" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Done -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
                    <Button Style="{StaticResource Button.Ghost}" Content="Copy log" Command="{Binding CopyLogCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="Finish" Command="{Binding CloseCommand}" MinWidth="120" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
