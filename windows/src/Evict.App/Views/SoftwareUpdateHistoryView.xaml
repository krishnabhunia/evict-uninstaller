<UserControl x:Class="Evict.App.Views.SoftwareUpdateHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Evict.Core.Models;assembly=Evict.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="UpdateResultTemplate">
            <Border x:Name="Badge" Background="{DynamicResource Brush.Badge.Background}" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left">
                <TextBlock x:Name="BadgeText" Text="{Binding Result}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SoftwareUpdateOutcome.Updated}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SoftwareUpdateOutcome.Failed}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SoftwareUpdateOutcome.RestartRequired}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SoftwareUpdateOutcome.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="Result" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <ComboBox ItemsSource="{Binding Filters}" DisplayMemberPath="Value"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="158" Margin="0,0,10,0"
                          AutomationProperties.Name="Filter update history by result" />
                <Button Content="History settings" Command="{Binding ShowSettingsCommand}" Style="{StaticResource Button.Secondary}" />
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="Last 7 days" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{Binding WindowText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="View policy" Command="{Binding ShowSettingsCommand}" Style="{StaticResource Button.Link}" Margin="12,0,0,0" />
                <TextBlock Text="Kept on this device for 7 days. Older records are automatically removed."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,12" />
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" MinHeight="250">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource DataGrid.Flat}"
                          Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Program" Width="*" MinWidth="170" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}" />
                                        <TextBlock Text="{Binding PackageId}" Style="{StaticResource Cell.Secondary}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Version change" Binding="{Binding VersionChange}" Width="160" />
                        <DataGridTemplateColumn Header="Result" Width="145" SortMemberPath="Result">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource UpdateResultTemplate}" VerticalAlignment="Center" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="120" />
                        <DataGridTemplateColumn Header="Details" Width="65" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View" Style="{StaticResource Button.Link}"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='View {0} update details'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="410" Margin="20"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No updates recorded yet" Style="{StaticResource Text.Section}" TextAlignment="Center" />
                    <TextBlock Text="Updates run through Evict will appear here for 7 days, including failed and cancelled attempts."
                               Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <Button Content="Check for updates" Command="{Binding ShowAvailableUpdatesCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="410" Margin="20"
                            Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No matching updates" Style="{StaticResource Text.Section}" TextAlignment="Center" />
                    <TextBlock Text="No results with this status in the last 7 days." Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,8,0,16" />
                    <Button Content="Show all results" Command="{Binding ResetFilterCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="410" Margin="20"
                            Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="History could not be loaded" Style="{StaticResource Text.Section}" TextAlignment="Center" />
                    <TextBlock Text="Your programs are not affected. Existing records have not been replaced. Retry loading your saved history."
                               Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <Button Content="Try again" Command="{Binding RetryPersistenceCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding Feedback}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding TimeZoneText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            <TextBlock Text="Only updates attempted through Evict are shown." Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
