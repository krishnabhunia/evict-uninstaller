<Window x:Class="Evict.App.Views.WindowsUpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WindowsUpdatesViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="Windows Updates" Width="860" Height="600" MinWidth="700" MinHeight="460"
        Icon="pack://application:,,,/Assets/app.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Windows Updates" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" Text="Installed updates and hotfixes (as reported by Windows). Uninstalling uses wusa.exe and may require a restart. Windows Update can reinstall an update unless you pause updates." />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Refresh" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGrid.Flat}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,0,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Update" Width="120" SortMemberPath="Id">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
                                    <Button Style="{StaticResource Button.Link}" Content="{Binding Id}" Command="{Binding DataContext.OpenKbPageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Left" ToolTip="Open the Microsoft support page" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Description" Width="*" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:UpdateItemViewModel}"><TextBlock Text="{Binding Description}" Style="{StaticResource Cell.Primary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Installed on" Width="120" SortMemberPath="Info.InstalledOn">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:UpdateItemViewModel}"><TextBlock Text="{Binding InstalledOn}" Style="{StaticResource Cell.Secondary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Installed by" Width="160" SortMemberPath="InstalledBy">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:UpdateItemViewModel}"><TextBlock Text="{Binding InstalledBy}" Style="{StaticResource Cell.Secondary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="200">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type vm:UpdateItemViewModel}"><TextBlock Text="{Binding Status}" Style="{StaticResource Cell.Secondary}" ToolTip="{Binding Status}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Visibility="{Binding Error, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="8" Padding="16">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Text="A restart is required to finish removing an update." Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Secondary}" Content="Close" Command="{Binding CloseCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                <Button Style="{StaticResource Button.Danger}" Content="Uninstall selected" Command="{Binding UninstallSelectedCommand}" MinWidth="160" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
