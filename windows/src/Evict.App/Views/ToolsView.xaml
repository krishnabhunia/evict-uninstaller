<UserControl x:Class="Evict.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Evict.App.ViewModels"
             xmlns:ctl="clr-namespace:Evict.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolsViewModel}">

    <!-- RD1 Clean: nine tool tiles (what it does + one action), then shortcuts. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,20">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Visibility="{Binding StatusText, Converter={StaticResource BoolToVis}}" Margin="2,0,0,10" />

            <ItemsControl ItemsSource="{Binding TileTools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveUniformGrid MinColumnWidth="230" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
                        <Button Style="{StaticResource Button.Tile}" Margin="0,0,14,14" MinHeight="168"
                                Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Top" ToolTip="Needs administrator rights"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <TextBlock Text="Admin" Style="{StaticResource Tag.Text}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brush.Accent.Subtle}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Brush.Accent.Text}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Text}">
                                    <Run Text="{Binding ActionText, Mode=OneWay}" /><Run Text=" →" />
                                </TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Also" Style="{StaticResource Text.Eyebrow}" Margin="2,6,0,6" />
            <ItemsControl ItemsSource="{Binding MoreTools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
                        <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" ToolTip="{Binding Description}"
                                Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
