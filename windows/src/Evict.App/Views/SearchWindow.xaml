<Window x:Class="Evict.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
        Title="Search Evict" Width="620" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Body}" FontSize="13" TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- RD1 "Search anything" (Ctrl+K): grouped Apps / Actions / Settings results. -->
    <Border Margin="16" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="18,14,14,12">
                <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface.Sunken}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </Border>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,12,0" />
                <Grid>
                    <TextBlock Text="Search programs, tools and settings" FontSize="16" Foreground="{DynamicResource Brush.Text.Tertiary}" IsHitTestVisible="False"
                               Visibility="{Binding Query, Converter={StaticResource InvBoolToVis}}" VerticalAlignment="Center" />
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Brush.Text.Primary}" CaretBrush="{DynamicResource Brush.Text.Primary}" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search" PreviewKeyDown="OnQueryKeyDown" />
                </Grid>
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" />

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding HintText}" Style="{StaticResource Text.Caption}" Margin="18,8,18,12" />
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Divider}" />

            <Grid>
                <TextBlock Text="Nothing matches. Try another word." Style="{StaticResource Text.Caption}" Margin="18,18" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ListBox x:Name="ResultsList" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Style="{StaticResource ListBox.Flat}" Margin="8,4,8,6"
                         MaxHeight="400" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="OnResultClick" Focusable="False">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Eyebrow}" Margin="10,10,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                            <DockPanel Margin="2,5">
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Surface.Sunken}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Detail, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
