<Window x:Class="Evict.App.Views.FileShredderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FileShredderViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="File Shredder" Width="760" Height="560" MinWidth="620" MinHeight="460"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="File Shredder" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" Text="Overwrites file contents before deleting so the data cannot be recovered with undelete tools. Drag files or folders into this window." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource Button.Secondary}" Content="Add files…" Command="{Binding AddFilesCommand}" />
            <Button Style="{StaticResource Button.Secondary}" Content="Add folder…" Command="{Binding AddFolderCommand}" Margin="8,0,0,0" />
            <Button Style="{StaticResource Button.Ghost}" Content="Remove" Command="{Binding RemovePathCommand}" Margin="8,0,0,0" IsEnabled="{Binding SelectedPath, Converter={StaticResource ToBool}}" />
            <Button Style="{StaticResource Button.Ghost}" Content="Clear" Command="{Binding ClearPathsCommand}" Margin="4,0,0,0" IsEnabled="{Binding HasPaths}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListBox Style="{StaticResource ListBox.Flat}" ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath, Mode=TwoWay}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Margin="6" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasPaths, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="36" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="Drop files or folders here" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Method:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Method, Mode=TwoWay}" Width="210" />
                <TextBlock Text="{Binding MethodDescription}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="Note: on SSDs the drive's wear-levelling may keep old copies of data internally; shredding is most effective on hard disks. Files are not sent to the Recycle Bin." />
            <Grid Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" />
            </Grid>
            <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Text.Body}">
                    <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding BytesText, Mode=OneWay}" /><Run Text=" overwritten." />
                </TextBlock>
            </Border>
            <ItemsControl ItemsSource="{Binding Errors}" MaxHeight="80" Margin="0,6,0,0" Visibility="{Binding Errors.Count, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="Close" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
            <Button Style="{StaticResource Button.Danger}" Command="{Binding ShredCommand}" MinWidth="160">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                    <TextBlock Text="Shred permanently" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
