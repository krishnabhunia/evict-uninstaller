<Window x:Class="Evict.App.Views.SoftwareUpdateHistorySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update history settings" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource Window.Dialog}">
    <StackPanel Margin="24">
        <TextBlock Text="Update history settings" Style="{StaticResource Text.Section}" />
        <TextBlock Text="Last 7 days · stored on this device" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,16,0,6" />
        <TextBlock Text="{Binding HistoryKeepText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
        <TextBlock Text="History includes package names, versions, outcomes, times and the last 40 output lines. Evict’s own updates remain included. Clearing history preserves running attempts, your installed programs and exclusions."
                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,14,0,0" />
        <TextBlock Text="{Binding HistoryPersistenceError}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Visibility="{Binding HasHistoryPersistenceError, Converter={StaticResource BoolToVis}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Clear completed history…" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding CanClearHistory}" Style="{StaticResource Button.Secondary}" />
            <Button Content="Done" Click="Done" IsDefault="True" IsCancel="True" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
