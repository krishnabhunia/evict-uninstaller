<UserControl x:Class="Evict.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Evict.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">

    <UserControl.Resources>
        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Scan for leftovers again…" Command="{Binding RescanLeftoversCommand}" CommandParameter="{Binding SelectedItem}" />
            <MenuItem Header="Remove from history" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}" />
        </ContextMenu>
    </UserControl.Resources>

    <!-- RD1 History: one timeline (uninstalls and program updates), filter chips, grouped by day. -->
    <Grid Margin="28,4,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource TextBox.Search}" Width="240" Tag="Search history…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Export CSV" Command="{Binding ExportCommand}" Margin="8,0,0,0" ToolTip="Uninstall history as a CSV file" />
                <Button Style="{StaticResource Button.Ghost}" Content="Clear" Command="{Binding ClearAllCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Button.Chip}" GroupName="HistoryFilter" Content="All" Margin="0,0,6,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Button.Chip}" GroupName="HistoryFilter" Content="Uninstalls" Margin="0,0,6,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=Uninstalls}" />
                <RadioButton Style="{StaticResource Button.Chip}" GroupName="HistoryFilter" Content="Updates" Margin="0,0,12,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=Updates}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,4" Margin="0,14,0,0">
            <Grid>
                <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Style="{StaticResource ListBox.Flat}" ContextMenu="{StaticResource RowMenu}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="History">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Eyebrow}" Margin="12,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TimelineItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,12,0"
                                        Background="{Binding IsUpdate, Converter={StaticResource BoolToBrush}, ConverterParameter='Brush.Accent.Subtle|Brush.Danger.Subtle'}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14"
                                               Foreground="{Binding IsUpdate, Converter={StaticResource BoolToBrush}, ConverterParameter='Brush.Accent.Text|Brush.Danger.Text'}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notes}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Tag}" Visibility="{Binding Succeeded, Converter={StaticResource InvBoolToVis}}" Background="{DynamicResource Brush.Warning.Subtle}">
                                    <TextBlock Text="Check" Style="{StaticResource Tag.Text}" Foreground="{DynamicResource Brush.Warning}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="36" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="Nothing here yet" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,10,0,4" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="Every uninstall and program update is recorded here." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                   Text="Uninstalls are kept until cleared; program updates for 7 days. Recycled leftovers still occupy space until the Recycle Bin is emptied. Right-click an uninstall to rescan." />
    </Grid>
</UserControl>
