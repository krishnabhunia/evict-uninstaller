<UserControl x:Class="Evict.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Evict.App.ViewModels"
             xmlns:conv="clr-namespace:Evict.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}">

    <UserControl.Resources>
        <conv:ScoreArcConverter x:Key="ScoreArc" />
        <conv:ScoreBrushConverter x:Key="ScoreBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" Text="A quick view of your software health, with checks and fixes you can review before applying." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding FixSelectedCommand}" IsEnabled="{Binding CanFix}" Padding="14,8" Margin="0,0,10,0"
                            ToolTip="Apply the safe fix of every ticked category below">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="Fix selected" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Scan now" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The real health score and scan status drive the redesigned hero; no sample data. -->
            <Border Background="{DynamicResource Brush.Hero.Background}" CornerRadius="14" Margin="0,18,0,18" Padding="26,23">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="156" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="SOFTWARE HEALTH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Sidebar.Status}" />
                        <TextBlock Text="{Binding ScoreLabel}" FontSize="27" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource Brush.Hero.Subtitle}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="{Binding LastScanText}" FontSize="12" Foreground="{DynamicResource Brush.Hero.Subtitle}" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="150" Margin="12,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="142" Height="142" HorizontalAlignment="Right">
                        <Ellipse Stroke="#49687B" StrokeThickness="11" Margin="6" />
                        <Path Stroke="{Binding Score, Converter={StaticResource ScoreBrush}}" StrokeThickness="11"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{Binding Score, Converter={StaticResource ScoreArc}}" Margin="6"
                              Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontSize="39" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Score}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScore}" Value="False"><Setter Property="Text" Value="–" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Text" Value="…" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Health / 100" FontSize="11" Foreground="{DynamicResource Brush.Hero.Subtitle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Health checks" Style="{StaticResource Text.Section}" FontSize="17" />
                <TextBlock Grid.Column="1" Text="Review recommendations before applying fixes" Style="{StaticResource Text.Caption}" />
            </Grid>

            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthTileViewModel}">
                        <Border Style="{StaticResource Card}" Width="300" MinHeight="168" Margin="0,0,14,14" Padding="18,17">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Glyph}" FontSize="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="14" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <CheckBox Grid.Row="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,10,0,0" Visibility="{Binding ShowSelection, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Include in &quot;Fix selected&quot;">
                                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Caption}" />
                                </CheckBox>
                                <TextBlock Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,10,0,12" TextWrapping="Wrap" />
                                <Grid Grid.Row="3">
                                    <ProgressBar IsIndeterminate="True" HorizontalAlignment="Left" Width="120" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="{Binding ActionText}" HorizontalAlignment="Right" MinWidth="96" Padding="12,5" MinHeight="30"
                                            Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="The score is a simple heuristic (100 minus a small penalty per finding) meant to guide you, not a security rating. 'Possible bundleware' and 'not used recently' are guesses from install timestamps and Windows usage counters – always review before removing." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
