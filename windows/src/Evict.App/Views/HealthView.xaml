<UserControl x:Class="Evict.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Evict.App.ViewModels"
             xmlns:conv="clr-namespace:Evict.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}">

    <UserControl.Resources>
        <conv:ScoreArcConverter x:Key="ScoreArc" />
        <conv:ScoreBrushConverter x:Key="ScoreBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Software Health" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" Text="One place to see outdated software, leftovers, bundleware, risky extensions and unused programs – each with a one-click way to deal with it." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}" Padding="14,8" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" />
                        <TextBlock Text="Scan now" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Score card -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,14" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="132" Height="132">
                        <Ellipse Stroke="{DynamicResource Brush.Progress.Track}" StrokeThickness="11" Margin="6" />
                        <Path Stroke="{Binding Score, Converter={StaticResource ScoreBrush}}" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{Binding Score, Converter={StaticResource ScoreArc}}" Margin="6" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Score}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScore}" Value="False"><Setter Property="Text" Value="–" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Text" Value="…" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="/ 100" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{Binding ScoreLabel}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="180" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthTileViewModel}">
                        <Border Style="{StaticResource Card}" Width="300" MinHeight="168" Margin="0,0,14,14" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Glyph}" FontSize="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="14" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,12,0,12" TextWrapping="Wrap" />
                                <Grid Grid.Row="2">
                                    <ProgressBar IsIndeterminate="True" HorizontalAlignment="Left" Width="120" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="{Binding ActionText}" HorizontalAlignment="Right" MinWidth="96" Padding="12,5" MinHeight="30"
                                            Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="The score is a simple heuristic (100 minus a small penalty per finding) meant to guide you, not a security rating. 'Possible bundleware' and 'not used recently' are guesses from install timestamps and Windows usage counters – always review before removing." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
