<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Evict.App.ViewModels"
                    xmlns:views="clr-namespace:Evict.App.Views">

    <!-- View model → view. The main window's ContentControl picks these up automatically. -->
    <DataTemplate DataType="{x:Type vm:HealthViewModel}">
        <views:HealthView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
        <views:ProgramsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WindowsAppsViewModel}">
        <views:WindowsAppsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BrowserExtensionsViewModel}">
        <views:BrowserExtensionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SoftwareUpdaterViewModel}">
        <views:SoftwareUpdaterView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstallMonitorViewModel}">
        <views:InstallMonitorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <views:ToolsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <views:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>

</ResourceDictionary>
