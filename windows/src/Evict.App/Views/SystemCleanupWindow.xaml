<Window x:Class="Evict.App.Views.SystemCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SystemCleanupViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="System Cleanup" Width="980" Height="700" MinWidth="800" MinHeight="540"
        Icon="pack://application:,,,/Assets/app.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="System Cleanup" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Junk that ordinary uninstallers never touch: orphaned Windows Installer packages, data of removed Store apps, update caches, temporary files, error reports and crash dumps. Everything is measured first – nothing is removed until you choose." />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.Warning.Subtle}" VerticalAlignment="Top" Margin="16,4,0,0"
                    Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Warning}" Text="Not administrator – Windows folders are measured but cannot be cleaned" />
            </Border>
        </Grid>

        <!-- Idle -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Idle}">
            <StackPanel>
                <TextBlock Text="What is checked" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Windows Installer cache – .msi / .msp files in C:\Windows\Installer that no installed program or patch refers to (moved to a backup folder, not deleted)" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Data folders of Store apps that are no longer installed for your account" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Windows Update download cache and Delivery Optimization cache" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Temporary files of Windows and of your account (older than 24 hours)" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Windows Error Reporting files and crash dumps" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,14" Text="•  Previous Windows installation (Windows.old) – measured, removed through Storage settings" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                <Button Style="{StaticResource Button.Primary}" Content="Scan now" Command="{Binding ScanCommand}" HorizontalAlignment="Left" MinWidth="140" />
            </StackPanel>
        </Border>

        <!-- Scanning / Cleaning -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" MaxWidth="760" />
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Width="480" IsIndeterminate="{Binding ProgressIndeterminate}" />
        </StackPanel>

        <!-- Review -->
        <Grid Grid.Row="1" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                    <Run Text="Found " /><Run Text="{Binding TotalFoundText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" of removable data. Items marked " /><Run Text="Review" FontWeight="SemiBold" /><Run Text=" are unchecked – look before you include them. Expand a category to see and pick individual items." />
                </TextBlock>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CleanupGroupViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding HasItems}"
                                                  Visibility="{Binding OpensSettings, Converter={StaticResource InvBoolToVis}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{DynamicResource Brush.Warning.Subtle}" Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Warning}" Text="administrator" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding Note, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button Style="{StaticResource Button.Secondary}" Content="Open Storage settings" Padding="10,5"
                                                    Command="{Binding DataContext.OpenSpecialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding OpensSettings, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Margin="6,0,0,0" ToolTip="Show / hide items"
                                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ListView Style="{StaticResource ListView.Flat}" ItemsSource="{Binding Items}" Margin="0,10,0,0" MaxHeight="320"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.View>
                                            <GridView ColumnHeaderContainerStyle="{StaticResource GridViewHeader}">
                                                <GridViewColumn Width="36">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Group.OpensSettings, Converter={StaticResource InvBool}}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Item" Width="430">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Cell.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Kind" Width="170">
                                                    <GridViewColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleanupItemViewModel}"><TextBlock Text="{Binding Detail}" Style="{StaticResource Cell.Secondary}" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Size" Width="100">
                                                    <GridViewColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleanupItemViewModel}"><TextBlock Text="{Binding SizeText}" Style="{StaticResource Cell.Secondary}" HorizontalAlignment="Right" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Confidence" Width="90">
                                                    <GridViewColumn.CellTemplate><DataTemplate DataType="{x:Type vm:CleanupItemViewModel}"><TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Cell.Secondary}" /></DataTemplate></GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="60">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                                                            <Button Style="{StaticResource Button.Link}" Content="Open" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Done -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                    <TextBlock Text="Cleanup finished" Style="{StaticResource Text.Section}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding BackupFolder, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Orphaned installer packages were moved to a backup folder. Delete that folder yourself once you are sure every program still repairs and uninstalls fine." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Link}" Content="Open backup folder" Command="{Binding OpenBackupFolderCommand}" Margin="10,0,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,10,0,0" MaxHeight="220">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}">
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Body}" />
                <CheckBox IsChecked="{Binding MoveInstallerCacheToBackup}" Content="Move orphaned installer packages to a backup folder instead of deleting them (recommended)" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Button.Secondary}" Content="Scan again" Command="{Binding RescanCommand}" MinWidth="110" Margin="0,0,10,0"
                        Visibility="{Binding Step, Converter={StaticResource NotEqualsToVis}, ConverterParameter=Idle}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Close" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                <Button Style="{StaticResource Button.Danger}" Content="Clean selected" Command="{Binding CleanCommand}" MinWidth="150" IsEnabled="{Binding CanClean}"
                        Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=Review}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
