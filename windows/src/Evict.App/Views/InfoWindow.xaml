<Window x:Class="Evict.App.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        xmlns:core="clr-namespace:Evict.Core.Services;assembly=Evict.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InfoViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding Title}" Width="900" Height="660" MinWidth="640" MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- Design IN1: This build · What's implemented · What's new · Under the hood. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Image Source="pack://application:,,,/Assets/app-256.png" Width="44" Height="44" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <!-- 1 · This build -->
            <TabItem Header="This build" AutomationProperties.Name="This build">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding HasBetaBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Brush.Warning}" DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding BetaBanner}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <DataGrid Style="{StaticResource DataGrid.Flat}" ItemsSource="{Binding BuildRows}" SelectionMode="Single" CanUserSortColumns="False"
                              AutomationProperties.Name="This build details">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SrNo." Binding="{Binding SrNo}" Width="64" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="160" />
                            <DataGridTemplateColumn Header="This copy" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Cell.Primary}" TextWrapping="Wrap" TextTrimming="None"
                                                       Visibility="{Binding HasUrl, Converter={StaticResource InvBoolToVis}}" />
                                            <Button Style="{StaticResource Button.Link}" Content="{Binding Value}" HorizontalAlignment="Left" Padding="0"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Url}"
                                                    ToolTip="{Binding Url}" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 2 · What's implemented (docs/FEATURES.md, embedded at build time) -->
            <TabItem Header="What's implemented" AutomationProperties.Name="What's implemented">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Button.Chip}" GroupName="FeatureFilter" Content="All areas" IsChecked="{Binding ShowAllAreas, Mode=TwoWay}" Margin="8,0,0,0" />
                            <RadioButton Style="{StaticResource Button.Chip}" GroupName="FeatureFilter" Content="{Binding NewInLabel}" IsChecked="{Binding ShowNewOnly, Mode=TwoWay}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBox Style="{StaticResource TextBox.Search}" Tag="Search features" Text="{Binding FeatureQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search features" MinWidth="220" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FeatureCountText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    <DataGrid Style="{StaticResource DataGrid.Flat}" ItemsSource="{Binding FilteredFeatures}" SelectionMode="Single"
                              AutomationProperties.Name="Implemented features">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SrNo." Binding="{Binding SrNo}" Width="64" />
                            <DataGridTemplateColumn Header="Area" Width="190" SortMemberPath="Area">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type core:FeatureRow}">
                                        <TextBlock Text="{Binding Area}" Style="{StaticResource Cell.Primary}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Margin="0,6" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="What it does" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type core:FeatureRow}">
                                        <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Cell.Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3 · What's new (this version's CHANGELOG section, embedded at build time) -->
            <TabItem Header="What's new" AutomationProperties.Name="What's new">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding WhatsNewHeading}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Tag}" Background="{DynamicResource Brush.Warning.Subtle}" Margin="10,0,0,0"
                                Visibility="{Binding HasWhatsNewNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WhatsNewNote}" Style="{StaticResource Tag.Text}" Foreground="{DynamicResource Brush.Text.Primary}" />
                        </Border>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Link}" Content="All releases on GitHub" HorizontalAlignment="Left"
                            Command="{Binding OpenReleasesCommand}" Margin="0,10,0,0" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <TextBlock Text="{Binding WhatsNewText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- 4 · Under the hood -->
            <TabItem Header="Under the hood" AutomationProperties.Name="Under the hood">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Open log file" Command="{Binding OpenLogFileCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid Style="{StaticResource DataGrid.Flat}" ItemsSource="{Binding StackRows}" SelectionMode="Single" CanUserSortColumns="False"
                              AutomationProperties.Name="What this copy uses">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SrNo." Binding="{Binding SrNo}" Width="64" />
                            <DataGridTextColumn Header="Part" Binding="{Binding Item}" Width="160" />
                            <DataGridTemplateColumn Header="This copy uses" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Cell.Primary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Close" IsCancel="True" Click="OnClose" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Copy build info" Command="{Binding CopyBuildInfoCommand}"
                    ToolTip="Copies the version, pull request, commit, build time, Windows version and install type" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
