<Window x:Class="Evict.App.Views.VersionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:VersionPickerViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="Evict versions" Width="1000" Height="740" MinWidth="820" MinHeight="600"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- Version picker (design VP1): you always choose the exact version; nothing is selected for you. -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Assets/app-256.png" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Evict versions" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Tabs: Updates | Version history & roll back -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="-12,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                <RadioButton Style="{StaticResource Button.Tab}" GroupName="VersionPickerTabs" IsChecked="{Binding IsUpdatesTab, Mode=TwoWay}" Content="Updates"
                             AutomationProperties.Name="Updates" />
                <RadioButton Style="{StaticResource Button.Tab}" GroupName="VersionPickerTabs" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}" Content="Version history &amp; roll back"
                             AutomationProperties.Name="Version history and roll back" />
            </StackPanel>
        </Border>

        <!-- Notices: what the list holds; the pin -->
        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource Brush.Info.Subtle}" CornerRadius="8" Padding="14,9" Margin="0,0,0,10"
                    Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding BannerText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="8" Padding="14,8" Margin="0,0,0,10"
                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Unpin" Command="{Binding UnpinCommand}" Margin="12,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                    <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PinnedText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ═══════════ Step 1: pick a version ═══════════ -->
        <Grid Grid.Row="3" Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Refresh list" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Filter by channel">
                        <RadioButton Style="{StaticResource Button.Chip}" GroupName="VersionPickerFilter" IsChecked="{Binding IsAll, Mode=TwoWay}" Content="{Binding AllText}" />
                        <RadioButton Style="{StaticResource Button.Chip}" GroupName="VersionPickerFilter" IsChecked="{Binding IsStableOnly, Mode=TwoWay}" Content="{Binding StableText}" Margin="6,0,0,0" />
                        <RadioButton Style="{StaticResource Button.Chip}" GroupName="VersionPickerFilter" IsChecked="{Binding IsBetaOnly, Mode=TwoWay}" Content="{Binding BetaText}" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <ListBox Style="{StaticResource ListBox.Flat}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Versions"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VersionOptionViewModel}">
                                    <Grid Margin="8,8" AutomationProperties.Name="{Binding Version}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Version}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Warning.Subtle}" Margin="0,0,6,0"
                                                        Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Beta" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Accent.Subtle}" Margin="0,0,6,0"
                                                        Visibility="{Binding IsStable, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Stable" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Accent.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Background="Transparent" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                                        Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource Pill.Text}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Success.Subtle}" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsOnThisPc, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="On this PC" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                            </Border>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                                       Visibility="{Binding IsDownload, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="GitHub only" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                                       Visibility="{Binding CanInstall, Converter={StaticResource InvBoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="160" Height="6" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Detail pane -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding NoSelectionText}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NoSelectionHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="YOU SELECTED" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding Selected.Version}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,2" />
                            <TextBlock Text="{Binding FromToText}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />

                            <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding SelectedIsBeta, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Warning}" DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="Beta builds can be unstable. Your current version is kept, so you can roll back any time." Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource Brush.Info.Subtle}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding SelectedIsStable, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="Stable release — recommended for daily use." Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding SelectedCannotInstall, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Evict cannot install this version itself: its file or its SHA-256 checksum is missing from the release. You can download it from GitHub."
                                               Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource Button.Link}" Content="Open this release on GitHub" Command="{Binding OpenReleasePageCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Roll back: settings -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSettingsBackup, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Settings after the roll back" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                                <RadioButton GroupName="VersionPickerSettings" IsChecked="{Binding RestoreSettings, Mode=TwoWay}" Margin="0,0,0,6"
                                             Content="Put back the settings I used with this version (recommended)" />
                                <RadioButton GroupName="VersionPickerSettings" IsChecked="{Binding KeepCurrentSettings, Mode=TwoWay}"
                                             Content="Keep my current settings" />
                            </StackPanel>
                            <TextBlock Text="No settings were saved for this version, so your current settings stay. Older versions ignore settings they do not know."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding NoSettingsBackup, Converter={StaticResource BoolToVis}}" />

                            <DockPanel Margin="0,16,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Release page" Command="{Binding OpenReleasePageCommand}" />
                                <TextBlock Text="What's new" Style="{StaticResource Text.Section}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Selected.Notes}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Step 2: confirm ═══════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource Text.Section}" FontSize="18" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="FROM (INSTALLED)" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,4">
                                <Run Text="v" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding FromDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="changes to" />
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="TO (YOUR CHOICE)" Style="{StaticResource Text.Eyebrow}" Foreground="{DynamicResource Brush.Accent}" />
                            <WrapPanel Margin="0,4,0,4">
                                <TextBlock Text="{Binding ToVersion}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Warning.Subtle}"
                                        Visibility="{Binding SelectedIsBeta, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Beta" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Accent.Subtle}"
                                        Visibility="{Binding SelectedIsStable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Stable" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource Brush.Accent.Text}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding ToDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                        Visibility="{Binding ConfirmWarning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Brush.Warning}" DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ConfirmWarning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="What will happen" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="8" Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10"
                           Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="8" Padding="12,8" Visibility="{Binding Error, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding BackUpSettings}" Content="Save my settings before changing version" Margin="0,0,0,6" />
                    <CheckBox IsChecked="{Binding KeepCurrentCopy}" Content="{Binding KeepCurrentText}" Margin="0,0,0,6" />
                    <CheckBox IsChecked="{Binding Pin}" Content="Pin this version — hide newer updates until I unpin"
                              Visibility="{Binding ShowPin, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Button.Link}" Content="Don't remind me about these" Command="{Binding SkipTheseCommand}" Margin="0,0,16,0"
                            Visibility="{Binding IsUpdatesTab, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Close" Command="{Binding CloseCommand}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ContinueText}" Command="{Binding ContinueCommand}" MinWidth="190" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Pick a different version" Command="{Binding BackCommand}" Margin="0,0,10,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,10,0" MinWidth="100"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" MinWidth="190"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
