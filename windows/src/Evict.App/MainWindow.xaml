<Window x:Class="Evict.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Evict.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1320" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}" FontSize="13"
        TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <!-- A 1px glass edge at the bottom keeps the DWM drop shadow while we draw our own title bar.
             The top 56px (logo row + page header) drag the window. -->
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MaxMargin}}">

        <!-- ═══ Body (scaled by the text-size setting; scrolls when the zoomed body no longer fits) ═══ -->
        <ScrollViewer x:Name="BodyScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnBodyScrollChanged" Focusable="False" PanningMode="None">
        <Grid x:Name="Body" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Brush.Window.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Menu (RD1 N1): Home · Apps · Updates · Clean · History, Settings at the bottom ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo, name and version (the version is always visible in the main window). -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,12,0" Height="30">
                    <Image Source="pack://application:,,,/Assets/app-256.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Evict" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Sidebar.BrandText}" />
                    <Border Background="{DynamicResource Brush.Surface.Sunken}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="7" Padding="6,0" Margin="8,1,0,0" VerticalAlignment="Center"
                            ToolTip="Installed version – Settings → Updates checks for newer releases">
                        <TextBlock Text="{Binding VersionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>
                </StackPanel>

                <Button DockPanel.Dock="Top" Style="{StaticResource Button.RailSearch}" Command="{Binding OpenSearchCommand}" Margin="14,18,14,12"
                        ToolTip="Search programs, tools, pages and settings (Ctrl+K)" AutomationProperties.Name="Search (Ctrl+K)" />

                <!-- Bottom: Settings, then who Evict runs as. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,14">
                    <TextBlock Text="PREFERENCES" Foreground="{DynamicResource Brush.Nav.GroupHeading}" FontSize="10" FontWeight="Bold" Margin="24,9,12,7" />
                    <RadioButton DataContext="{Binding SettingsNav}" Style="{StaticResource Button.Nav}" GroupName="MainNav" Content="{Binding Title}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <Border Style="{StaticResource Divider}" Margin="22,10,22,10" />
                    <StackPanel Orientation="Horizontal" Margin="24,2,12,0" Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}"
                                ToolTip="Evict can remove machine-wide programs, Program Files leftovers and services, and make restore points">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                        <TextBlock Text="Running as administrator" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RestartAsAdministratorCommand}" HorizontalAlignment="Stretch" Margin="14,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="Restart as administrator" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Nav.GroupHeading}"
                                                   FontSize="10" FontWeight="Bold" Margin="24,16,12,7" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <RadioButton Style="{StaticResource Button.Nav}" GroupName="MainNav" Content="{Binding Title}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Content ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header: title + subtitle; "Update to vX" top-right, only when an update exists. -->
            <DockPanel Grid.Row="0" Margin="28,16,150,12" MinHeight="48">
                <Button DockPanel.Dock="Right" Command="{Binding OpenUpdatesCommand}" Style="{StaticResource Button.Update}"
                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" ToolTip="{Binding UpdateBannerText}"
                        VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding AvailableUpdateButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding AvailableUpdateButtonText}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentSubtitle}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- Tabs for menu entries with more than one page (Apps, Clean). -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Margin="28,0,28,6"
                    Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding CurrentTabs}" Margin="-12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageTabViewModel}">
                            <RadioButton Style="{StaticResource Button.Tab}" GroupName="PageTabs" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" />
                                    <Border Style="{StaticResource Badge}" Visibility="{Binding Badge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Generic notice (background results when no tray icon is shown) -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Header.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="28,0,28,10"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,4"
                            Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Open" Command="{Binding NoticeActionCommand}" Margin="12,0"
                            Visibility="{Binding NoticeHasAction, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding NoticeText}" />
                </DockPanel>
            </Border>

            <!-- Installer detected prompt -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Info.Subtle}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="28,0,28,10"
                    Visibility="{Binding ShowInstallerBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,4"
                            Command="{Binding DismissInstallerBannerCommand}" ToolTip="Don't record this installation" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="OK" Command="{Binding RecordPendingInstallerCommand}" Margin="12,0" Padding="12,4" />
                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding InstallerBannerText}" />
                </DockPanel>
            </Border>

            <!-- Update available banner -->
            <Border Grid.Row="4" Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="28,0,28,10"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,4"
                            Command="{Binding DismissUpdateBannerCommand}" ToolTip="Not now" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Choose version…" Command="{Binding ShowUpdateCommand}" Margin="12,0" Padding="12,4" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Update settings / betas" Command="{Binding OpenUpdateSettingsCommand}" Margin="8,0" />
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding UpdateBannerText}" />
                </DockPanel>
            </Border>

            <!-- "Updated" notice (first start after a self-update) -->
            <Border Grid.Row="5" Background="{DynamicResource Brush.Success.Subtle}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="28,0,28,10"
                    Visibility="{Binding ShowUpdatedNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,4"
                            Command="{Binding DismissUpdatedNoticeCommand}" ToolTip="Dismiss" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="What's new" Command="{Binding OpenReleasesCommand}" Margin="12,0" />
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Success}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding UpdatedNoticeText}" />
                </DockPanel>
            </Border>

            <!-- Admin banner -->
            <Border Grid.Row="6" Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="28,0,28,10"
                    Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,4"
                            Command="{Binding DismissAdminBannerCommand}" ToolTip="Dismiss" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Restart as administrator" Command="{Binding RestartAsAdministratorCommand}" Margin="12,0" />
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Warning}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="Evict is running without administrator rights. Machine-wide programs, leftovers in Program Files, services and restore points need elevation." />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="7" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- Caption buttons stay outside the zoomed body so they never scale or scroll away. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="1">
            <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
            <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Maximize" />
            <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
        </StackPanel>
    </Grid>
</Window>
