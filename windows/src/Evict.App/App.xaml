<Application x:Class="Evict.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the theme dictionary; App.ApplyTheme swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- DataGrid.xaml merges Controls.xaml, which merges Converters.xaml. -->
                <ResourceDictionary Source="Styles/DataGrid.xaml" />
                <ResourceDictionary Source="Views/ViewMappings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
